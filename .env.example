# Default profile token. For multi-workspace setups, copy this file to
# `.env.<profile>` (e.g. `.env.work`, `.env.personal`) and select with
# `slack --profile <name> ...` or `SLACK_PROFILE=<name> slack ...`.
# Profile names must match [A-Za-z0-9._-]+ (no slashes).
SLACK_USER_TOKEN=xoxp-your-token-here
