#!/usr/bin/env node

const { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync } = require('fs');
const { join } = require('path');

// ── Profile resolution ────────────────────────────────────────────
// --profile <name> | --profile=<name>  (must appear before the subcommand
// to protect arbitrary-string positionals like `slack search "..."` from
// having a literal --profile= in their query treated as a flag).
// Falls back to SLACK_PROFILE env var. Empty string means unset.
// Last-wins for repeated --profile flags.

function extractGlobalFlags(argv) {
  let profile = null;
  let i = 0;
  while (i < argv.length) {
    const arg = argv[i];
    if (arg === '--profile') {
      if (i + 1 >= argv.length) {
        console.error("Error: --profile requires a value");
        process.exit(1);
      }
      profile = argv[i + 1];
      i += 2;
      continue;
    }
    if (arg.startsWith('--profile=')) {
      profile = arg.slice('--profile='.length);
      i += 1;
      continue;
    }
    // First non-flag token: stop. Everything from here is the subcommand + its args.
    break;
  }
  return { profile, cleaned: argv.slice(i) };
}

const { profile: flagProfile, cleaned } = extractGlobalFlags(process.argv.slice(2));

let profile = null;
let profileSource = null;
if (flagProfile != null) {
  profile = flagProfile;
  profileSource = '--profile';
} else if (process.env.SLACK_PROFILE && process.env.SLACK_PROFILE !== '') {
  profile = process.env.SLACK_PROFILE;
  profileSource = 'SLACK_PROFILE';
}

// Validate profile name BEFORE anything else (security: blocks path traversal,
// supersedes help and config to prevent surprising filesystem access).
if (profile != null && !/^[A-Za-z0-9._-]+$/.test(profile)) {
  // JSON.stringify escapes control chars (incl. ANSI escapes) so a hostile
  // profile name like $'\x1b[31mEVIL' can't corrupt the terminal.
  console.error(`Error: invalid profile name ${JSON.stringify(profile)} (from ${profileSource}). Allowed characters: letters, digits, dot, underscore, dash.`);
  process.exit(1);
}

const helpFlags = ['help', '--help', '-h'];
const cmd = cleaned[0];
const cmdArgs = cleaned.slice(1);
const isHelp = !cmd || helpFlags.includes(cmd);
const isConfig = cmd === 'config';

// Resolve env file: profile set → .env.<profile>, else → .env
const envFileName = profile ? `.env.${profile}` : '.env';
const envFilePath = join(__dirname, envFileName);

// Load env file with three-branch error policy.
let envFileLoaded = false;
try {
  const content = readFileSync(envFilePath, 'utf8');
  for (const line of content.split('\n')) {
    const match = line.match(/^([^#=]+)=(.*)$/);
    if (match && !process.env[match[1].trim()]) process.env[match[1].trim()] = match[2].trim();
  }
  envFileLoaded = true;
} catch (err) {
  if (profile && !isHelp && !isConfig) {
    // Explicit profile + non-diagnostic command: hard error.
    console.error(`Error: profile '${profile}' not found at ${envFilePath}`);
    process.exit(1);
  }
  if (profile && (isHelp || isConfig)) {
    // Explicit profile + help/config: warn but continue (config is the diagnostic).
    console.warn(`Warning: profile '${profile}' not found at ${envFilePath}`);
  }
  // No profile + .env missing: silent (preserves prior behavior).
}

const TOKEN = process.env.SLACK_USER_TOKEN;
if (!TOKEN && !isHelp && !isConfig) {
  console.error('Error: SLACK_USER_TOKEN environment variable is not set.');
  console.error('Export it: export SLACK_USER_TOKEN=xoxp-...');
  process.exit(1);
}

const API = 'https://slack.com/api';
const userCache = new Map();
const channelCache = new Map();

// ── Slack API helpers ──────────────────────────────────────────────

async function slackGet(method, params = {}) {
  const qs = new URLSearchParams(params).toString();
  const url = `${API}/${method}${qs ? '?' + qs : ''}`;
  const res = await fetch(url, { headers: { Authorization: `Bearer ${TOKEN}` } });
  const data = await res.json();
  if (!data.ok) throw new Error(`Slack API ${method}: ${data.error}`);
  return data;
}

async function slackPost(method, body) {
  const res = await fetch(`${API}/${method}`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  if (!data.ok) throw new Error(`Slack API ${method}: ${data.error}`);
  return data;
}

// ── Resolvers ──────────────────────────────────────────────────────

async function resolveChannel(target) {
  // Raw channel/group/DM ID
  if (/^[CDG][A-Z0-9]+$/.test(target)) return target;

  // Raw user ID → open DM
  if (/^U[A-Z0-9]+$/.test(target)) {
    const data = await slackPost('conversations.open', { users: target });
    return data.channel.id;
  }

  // #channel-name
  if (target.startsWith('#')) {
    const name = target.slice(1);
    if (channelCache.has(name)) return channelCache.get(name);
    let cursor;
    do {
      const params = { types: 'public_channel,private_channel', limit: 200 };
      if (cursor) params.cursor = cursor;
      const data = await slackGet('conversations.list', params);
      for (const ch of data.channels) {
        channelCache.set(ch.name, ch.id);
        if (ch.name === name) return ch.id;
      }
      cursor = data.response_metadata?.next_cursor;
    } while (cursor);
    throw new Error(`Channel not found: #${name}`);
  }

  // @username → open DM
  if (target.startsWith('@')) {
    const userId = await resolveUser(target.slice(1));
    const data = await slackPost('conversations.open', { users: userId });
    return data.channel.id;
  }

  // Assume it's a channel name without #
  try {
    return await resolveChannel('#' + target);
  } catch {
    // Try as username without @
    try {
      const userId = await resolveUser(target);
      const data = await slackPost('conversations.open', { users: userId });
      return data.channel.id;
    } catch {
      throw new Error(`Could not resolve "${target}" as channel or user`);
    }
  }
}

async function resolveUser(username) {
  if (/^U[A-Z0-9]+$/.test(username)) return username;
  if (userCache.has(username)) return userCache.get(username);

  const allUsers = [];
  let cursor;
  do {
    const params = { limit: 200 };
    if (cursor) params.cursor = cursor;
    const data = await slackGet('users.list', params);
    for (const u of data.members) {
      userCache.set(u.name, u.id);
      allUsers.push(u);
      // Exact match on username or display name
      if (u.name === username || u.profile?.display_name_normalized === username) return u.id;
    }
    cursor = data.response_metadata?.next_cursor;
  } while (cursor);

  // Fuzzy fallback: case-insensitive matching on name, real_name, display_name
  const query = username.toLowerCase().replace(/[._-]/g, ' ');
  const tokens = query.split(/\s+/).filter(Boolean);

  function scoreUser(u) {
    if (u.deleted || u.is_bot) return 0;
    const haystack = [u.name, u.real_name, u.profile?.display_name, u.profile?.display_name_normalized]
      .filter(Boolean).join(' ').toLowerCase().replace(/[._-]/g, ' ');
    const words = haystack.split(/\s+/);
    // Each token must match: exact substring > prefix of a word > shared prefix (min 3 chars)
    let total = 0;
    for (const t of tokens) {
      if (haystack.includes(t)) { total += 3; continue; }
      // Check if token shares a prefix of 3+ chars with any word
      const best = words.reduce((max, w) => {
        let i = 0;
        while (i < t.length && i < w.length && t[i] === w[i]) i++;
        return Math.max(max, i);
      }, 0);
      if (best >= 3) { total += best / t.length; continue; }
      return 0; // token didn't match at all
    }
    return total;
  }

  const scored = allUsers.map(u => ({ u, score: scoreUser(u) })).filter(s => s.score > 0);
  scored.sort((a, b) => b.score - a.score);

  if (scored.length === 1 || (scored.length > 1 && scored[0].score > scored[1].score)) return scored[0].u.id;
  if (scored.length > 1) {
    const list = scored.slice(0, 5).map(({ u }) => {
      const display = u.profile?.display_name || u.real_name || '';
      return `  @${u.name} (${display}) ${u.id}`;
    }).join('\n');
    throw new Error(`Multiple users match "${username}":\n${list}\nBe more specific or use a user ID.`);
  }

  throw new Error(`User not found: @${username}`);
}

async function getUserName(userId) {
  if (userCache.has(userId)) return userCache.get(userId);
  try {
    const data = await slackGet('users.info', { user: userId });
    const name = data.user.profile.display_name || data.user.real_name || data.user.name;
    userCache.set(userId, name);
    return name;
  } catch {
    return userId;
  }
}

// ── File download ─────────────────────────────────────────────────

const SLACK_FILES_DIR = '/tmp/slack-files';

async function downloadFile(file) {
  if (!existsSync(SLACK_FILES_DIR)) mkdirSync(SLACK_FILES_DIR, { recursive: true });
  const ext = file.filetype ? `.${file.filetype}` : '';
  const safeName = (file.name || file.id || 'file').replace(/[^a-zA-Z0-9._-]/g, '_');
  const localPath = join(SLACK_FILES_DIR, `${file.id}_${safeName}`);
  if (existsSync(localPath)) return localPath;
  const url = file.url_private_download || file.url_private;
  if (!url) return null;
  const res = await fetch(url, { headers: { Authorization: `Bearer ${TOKEN}` } });
  if (!res.ok) return null;
  const buf = Buffer.from(await res.arrayBuffer());
  writeFileSync(localPath, buf);
  return localPath;
}

// ── Formatters ─────────────────────────────────────────────────────

function fmtTs(ts) {
  const d = new Date(parseFloat(ts) * 1000);
  return d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

async function fmtMessage(msg) {
  const name = msg.user ? await getUserName(msg.user) : (msg.bot_profile?.name || 'bot');
  const time = fmtTs(msg.ts);
  const thread = msg.thread_ts && msg.thread_ts !== msg.ts ? ` (thread)` : '';
  const replies = msg.reply_count ? ` [${msg.reply_count} replies]` : '';
  let fileLines = '';
  if (msg.files && msg.files.length > 0) {
    for (const file of msg.files) {
      const type = file.mimetype || 'unknown';
      const isImage = type.startsWith('image/');
      if (isImage) {
        const size = file.size ? ` ${(file.size / 1024).toFixed(1)}KB` : '';
        const dims = file.original_w && file.original_h ? ` ${file.original_w}x${file.original_h}` : '';
        fileLines += `\n  \x1b[36m📎 ${file.name || 'file'} (${type}${dims}${size}) [image not downloaded]\x1b[0m`;
      } else {
        const localPath = await downloadFile(file);
        if (localPath) {
          fileLines += `\n  \x1b[36m📎 ${file.name || 'file'} (${type}) → ${localPath}\x1b[0m`;
        } else {
          fileLines += `\n  \x1b[36m📎 ${file.name || 'file'} (${type}) [download unavailable]\x1b[0m`;
        }
      }
    }
  }
  return `\x1b[90m${time}\x1b[0m \x1b[1m${name}\x1b[0m${thread}${replies}\n  ${msg.text || '(no text)'}${fileLines}`;
}

// ── Commands ───────────────────────────────────────────────────────

async function cmdSend(args) {
  const target = args[0];
  if (!target) return usage();

  let threadTs, broadcast = false;
  const msgParts = [];

  for (let i = 1; i < args.length; i++) {
    if (args[i] === '-t' || args[i] === '--thread') {
      threadTs = args[++i];
    } else if (args[i] === '--broadcast') {
      broadcast = true;
    } else {
      msgParts.push(args[i]);
    }
  }

  let text = msgParts.join(' ');
  if (!text && !process.stdin.isTTY) {
    const chunks = [];
    for await (const chunk of process.stdin) chunks.push(chunk);
    text = Buffer.concat(chunks).toString().trim();
  }
  if (!text) { console.error('Error: No message text provided.'); return; }

  const channelId = await resolveChannel(target);
  const body = { channel: channelId, text };
  if (threadTs) {
    body.thread_ts = threadTs;
    if (broadcast) body.reply_broadcast = true;
  }

  const data = await slackPost('chat.postMessage', body);
  console.log(`Sent to ${target} (ts: ${data.ts})`);
}

async function cmdRead(args) {
  const target = args[0];
  if (!target) return usage();

  let limit = 20, threadTs;
  for (let i = 1; i < args.length; i++) {
    if (args[i] === '--limit' || args[i] === '-n') limit = parseInt(args[++i]) || 20;
    if (args[i] === '-t' || args[i] === '--thread') threadTs = args[++i];
  }

  const channelId = await resolveChannel(target);

  let messages;
  if (threadTs) {
    const data = await slackGet('conversations.replies', { channel: channelId, ts: threadTs, limit });
    messages = data.messages;
  } else {
    const data = await slackGet('conversations.history', { channel: channelId, limit });
    messages = data.messages.reverse();
  }

  for (const msg of messages) {
    console.log(await fmtMessage(msg));
    console.log();
  }
}

async function cmdSearch(args) {
  let limit = 20;
  const queryParts = [];

  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--limit' || args[i] === '-n') {
      limit = parseInt(args[++i]) || 20;
    } else {
      queryParts.push(args[i]);
    }
  }

  const query = queryParts.join(' ');
  if (!query) { console.error('Error: No search query provided.'); return; }

  const data = await slackGet('search.messages', { query, count: limit, sort: 'timestamp', sort_dir: 'desc' });
  const matches = data.messages?.matches || [];

  if (!matches.length) { console.log('No results found.'); return; }

  console.log(`Found ${data.messages.total} results (showing ${matches.length}):\n`);
  for (const msg of matches) {
    const name = msg.username || msg.user || 'unknown';
    const time = fmtTs(msg.ts);
    const ch = msg.channel?.name ? `#${msg.channel.name}` : '';
    console.log(`\x1b[90m${time}\x1b[0m \x1b[1m${name}\x1b[0m ${ch}`);
    console.log(`  ${msg.text || '(no text)'}`);
    console.log(`  \x1b[90mts: ${msg.ts}\x1b[0m`);
    console.log();
  }
}

async function cmdChannels(args) {
  let limit = 50;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--limit' || args[i] === '-n') limit = parseInt(args[++i]) || 50;
  }

  const data = await slackGet('conversations.list', { types: 'public_channel,private_channel', limit, exclude_archived: true });
  for (const ch of data.channels) {
    const priv = ch.is_private ? '(private)' : '';
    console.log(`  \x1b[1m#${ch.name}\x1b[0m ${priv} \x1b[90m${ch.id}\x1b[0m`);
  }
}

async function cmdUsers(args) {
  let limit = 200;
  const filterParts = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--limit' || args[i] === '-n') {
      limit = parseInt(args[++i]) || 200;
    } else {
      filterParts.push(args[i]);
    }
  }
  const filter = filterParts.join(' ').toLowerCase().replace(/[._-]/g, ' ');
  const tokens = filter ? filter.split(/\s+/).filter(Boolean) : [];

  let cursor;
  do {
    const params = { limit };
    if (cursor) params.cursor = cursor;
    const data = await slackGet('users.list', params);
    for (const u of data.members) {
      if (u.deleted || u.is_bot) continue;
      const display = u.profile?.display_name || u.real_name || '';
      if (tokens.length) {
        const haystack = [u.name, u.real_name, u.profile?.display_name, u.profile?.display_name_normalized]
          .filter(Boolean).join(' ').toLowerCase().replace(/[._-]/g, ' ');
        const words = haystack.split(/\s+/);
        const matches = tokens.every(t => {
          if (haystack.includes(t)) return true;
          return words.some(w => { let i = 0; while (i < t.length && i < w.length && t[i] === w[i]) i++; return i >= 3; });
        });
        if (!matches) continue;
      }
      console.log(`  \x1b[1m@${u.name}\x1b[0m ${display} \x1b[90m${u.id}\x1b[0m`);
    }
    cursor = data.response_metadata?.next_cursor;
  } while (cursor);
}

async function cmdDm(args) {
  let limit = 10;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--limit' || args[i] === '-n') limit = parseInt(args[++i]) || 10;
  }

  const data = await slackGet('conversations.list', { types: 'im', limit });
  const dms = data.channels.filter(c => !c.is_archived);

  for (const dm of dms) {
    try {
      const hist = await slackGet('conversations.history', { channel: dm.id, limit: 1 });
      const msg = hist.messages?.[0];
      if (!msg) continue;
      const name = dm.user ? await getUserName(dm.user) : 'unknown';
      const time = fmtTs(msg.ts);
      const preview = (msg.text || '(no text)').slice(0, 80).replace(/\n/g, ' ');
      console.log(`  \x1b[1m@${name}\x1b[0m \x1b[90m${time}\x1b[0m`);
      console.log(`    ${preview}`);
      console.log();
    } catch {}
  }
}

async function cmdReact(args) {
  const target = args[0];
  const ts = args[1];
  let emoji = args[2];
  if (!target || !ts || !emoji) {
    console.error('Usage: slack react <target> <ts> <emoji>');
    return;
  }
  emoji = emoji.replace(/:/g, '');
  const channelId = await resolveChannel(target);
  await slackPost('reactions.add', { channel: channelId, timestamp: ts, name: emoji });
  console.log(`Reacted with :${emoji}: on ${target}`);
}

async function cmdEdit(args) {
  const target = args[0];
  const ts = args[1];
  if (!target || !ts) {
    console.error('Usage: slack edit <target> <ts> <new message>');
    return;
  }
  const text = args.slice(2).join(' ');
  if (!text) { console.error('Error: No message text provided.'); return; }
  const channelId = await resolveChannel(target);
  await slackPost('chat.update', { channel: channelId, ts, text });
  console.log(`Edited message ${ts} in ${target}`);
}

async function cmdDelete(args) {
  const target = args[0];
  const ts = args[1];
  if (!target || !ts) {
    console.error('Usage: slack delete <target> <ts>');
    return;
  }
  const channelId = await resolveChannel(target);
  await slackPost('chat.delete', { channel: channelId, ts });
  console.log(`Deleted message ${ts} from ${target}`);
}

async function cmdGroup(args) {
  if (args.length < 2) {
    console.error('Usage: slack group <@user1> <@user2> [...] ["message"]');
    console.error('Example: slack group @dominic @obada "Hey team!"');
    return;
  }

  const users = [];
  const msgParts = [];
  let parsingUsers = true;

  for (const arg of args) {
    if (parsingUsers && (arg.startsWith('@') || /^U[A-Z0-9]+$/.test(arg))) {
      const userId = await resolveUser(arg.replace(/^@/, ''));
      users.push(userId);
    } else {
      parsingUsers = false;
      msgParts.push(arg);
    }
  }

  if (users.length < 2) {
    console.error('Error: Need at least 2 users for a group chat.');
    return;
  }

  const data = await slackPost('conversations.open', { users: users.join(',') });
  const channelId = data.channel.id;
  console.log(`Group chat opened (${channelId})`);

  const text = msgParts.join(' ');
  if (text) {
    await slackPost('chat.postMessage', { channel: channelId, text });
    console.log(`Message sent to group chat.`);
  }
}

async function cmdUpload(args) {
  const target = args[0];
  const filePath = args[1];
  if (!target || !filePath) {
    console.error('Usage: slack upload <target> <filepath>');
    return;
  }
  const channelId = await resolveChannel(target);
  const { basename } = require('path');
  const fileContent = readFileSync(filePath);
  const filename = basename(filePath);

  // Step 1: Get upload URL
  const urlData = await slackGet('files.getUploadURLExternal', {
    filename,
    length: fileContent.length,
  });

  // Step 2: Upload the file
  const form = new FormData();
  form.append('file', new Blob([fileContent]), filename);
  await fetch(urlData.upload_url, { method: 'POST', body: form });

  // Step 3: Complete the upload
  await slackPost('files.completeUploadExternal', {
    files: [{ id: urlData.file_id, title: filename }],
    channel_id: channelId,
  });

  console.log(`Uploaded ${filename} to ${target}`);
}

// ── Main ───────────────────────────────────────────────────────────

async function cmdConfig() {
  console.log(`profile: ${profile || 'default'}`);
  console.log(`envFile: ${envFilePath}`);
  console.log(`envFileLoaded: ${envFileLoaded}`);
  if (TOKEN) {
    console.log(`userToken: set`);
    const preview = TOKEN.length >= 9
      ? `${TOKEN.slice(0, 5)}...${TOKEN.slice(-4)}`
      : `***${TOKEN.slice(-Math.min(4, TOKEN.length))}`;
    console.log(`userTokenPreview: ${preview}`);
  } else {
    console.log(`userToken: not set`);
  }
  // List discoverable profiles (filter out template/sample/local files).
  const skip = new Set(['.env.example', '.env.sample', '.env.template', '.env.local']);
  let profiles = [];
  try {
    profiles = readdirSync(__dirname)
      .filter(f => f.startsWith('.env.') && !skip.has(f))
      .map(f => f.slice('.env.'.length))
      .sort();
  } catch {}
  console.log(`availableProfiles: ${profiles.length ? profiles.join(', ') : 'none'}`);
}

